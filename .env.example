DBA_LISTEN_ADDR=127.0.0.1:8080
DBA_RAW_DIR=./data/raw
DBA_BEARER_TOKEN=
# DayZ RestContext cannot set an arbitrary Authorization header. Use this only
# on a loopback-bound ingest endpoint and load the token from a server profile file.
DBA_QUERY_TOKEN=replace-with-a-long-random-token
DBA_MAX_REQUEST_BYTES=2097152
