DBA_LISTEN_ADDR=127.0.0.1:8080
DBA_RAW_DIR=./data/raw
DBA_BEARER_TOKEN=
# DayZ RestContext cannot set an arbitrary Authorization header. Use this only
# on a loopback-bound ingest endpoint and load the token from a server profile file.
DBA_QUERY_TOKEN=replace-with-a-long-random-token
DBA_MAX_REQUEST_BYTES=2097152
DBA_POSTGRES_PASSWORD=replace-with-a-long-random-password
DBA_REVIEW_TOKEN=replace-with-a-long-random-api-token
DBA_PUBLIC_BASE_URL=http://127.0.0.1:8082
# Comma-separated 64-bit Steam IDs. Authentication never grants access unless
# the verified Steam ID appears in this allowlist.
DBA_STEAM_ADMIN_IDS=76561198000000000
DBA_SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional when running reviewd directly. Compose supplies the map directory
# built into the single reviewd image.
DBA_MAP_DIR=
DBA_DEFAULT_MAP=chernarusplus
